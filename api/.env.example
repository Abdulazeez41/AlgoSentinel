# Testnet resource-server configuration
PORT=4021
ALGORAND_NETWORK=testnet
AVM_ADDRESS=YOUR_TESTNET_ALGORAND_ADDRESS
FACILITATOR_URL=https://facilitator.goplausible.xyz
INDEXER_URL=https://testnet-idx.algonode.cloud
TINYMAN_ANALYTICS_URL=https://testnet.analytics.tinyman.org/api/v1

# Prices are USD-denominated and settled in the configured network's USDC.
WALLET_RISK_PRICE=$0.002
POOL_HEALTH_PRICE=$0.005
NFT_CHECK_PRICE=$0.003
PREFLIGHT_PRICE=$0.003
COUNTERPARTY_PRICE=$0.001
ASSET_PRICE=$0.001
